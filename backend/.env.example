# Variables de entorno del API. Copiar a backend/.env y completar.
# Una prueba (EnvironmentVariablesDocumentedTest) verifica que todas las
# variables que lee application.properties esten en este archivo.
# Nunca subir el .env real: esta en .gitignore.

# --- Servidor y perfil ---------------------------------------------------
# Render define PORT automaticamente; en local se usa SERVER_PORT.
SERVER_PORT=8080
# PORT=
# En Render: prod (sin Swagger, logs en INFO). Vacio en local.
SPRING_PROFILES_ACTIVE=
# URL publica del API (retornos de Pagadito y Didit).
APP_PUBLIC_BASE_URL=http://localhost:8080
# Origenes de navegador permitidos, separados por coma. Vacio = ninguno.
APP_CORS_ALLOWED_ORIGINS=
# 0 en local; 1 detras del proxy de Render (toma la IP que agrega el proxy, no la del cliente).
APP_HTTP_TRUSTED_PROXY_HOPS=0

# --- Base de datos (docker compose) --------------------------------------
POSTGRES_DB=t4kash
POSTGRES_USER=t4kash
POSTGRES_PASSWORD=t4kash
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/t4kash
SPRING_DATASOURCE_USERNAME=t4kash
SPRING_DATASOURCE_PASSWORD=t4kash
SPRING_DATASOURCE_MAX_POOL_SIZE=5
SPRING_DATASOURCE_MIN_IDLE=1
SPRING_DATASOURCE_CONNECTION_TIMEOUT=30000
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# Flyway crea y actualiza el esquema al arrancar (ver database/README.md).
SPRING_FLYWAY_ENABLED=true
# Supabase desde Render (solo IPv4): usar el session pooler, puerto 5432.
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.PROJECT_REF
# SPRING_DATASOURCE_PASSWORD=contrasena-de-la-base

# --- Autenticacion -------------------------------------------------------
# Secreto para proteger los codigos de 6 digitos (minimo 32 caracteres).
# Generar con: openssl rand -hex 32
APP_AUTH_CODE_SECRET=
# Correos separados por coma. Los de ADMIN reciben el rol al iniciar sesion
# y lo pierden si se quitan de la lista.
APP_AUTH_ADMIN_EMAILS=
APP_AUTH_EVALUATOR_EMAILS=
APP_AUTH_VERIFICATION_MINUTES=15
APP_AUTH_VERIFICATION_RESEND_SECONDS=60
APP_AUTH_TWO_FACTOR_MINUTES=10
APP_AUTH_PASSWORD_RESET_MINUTES=15
# Bloqueo: fallos por correo + IP, y tope por cuenta desde cualquier IP.
APP_AUTH_LOGIN_MAX_ATTEMPTS=5
APP_AUTH_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=20
APP_AUTH_LOGIN_WINDOW_MINUTES=15
APP_AUTH_LOGIN_LOCK_MINUTES=15
# Limite por IP para POST /api/auth/**; las rutas que envian correo
# comparten un presupuesto menor.
APP_RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=20
APP_RATE_LIMIT_EMAIL_REQUESTS_PER_WINDOW=5
APP_RATE_LIMIT_EMAIL_WINDOW_MINUTES=10

# --- Correo --------------------------------------------------------------
# Sin correo nadie puede registrarse ni entrar (el login pide un codigo).
# Proveedor: brevo (API) o smtp. Si se agota la cuota de Brevo, cambiar a
# smtp y completar SMTP_*.
APP_MAIL_ENABLED=false
APP_MAIL_PROVIDER=smtp
APP_MAIL_FROM=
APP_MAIL_FROM_NAME=T4KASH
BREVO_API_URL=https://api.brevo.com
BREVO_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_CONNECTION_TIMEOUT=10000
SMTP_READ_TIMEOUT=15000
SMTP_WRITE_TIMEOUT=15000

# --- Archivos (Supabase Storage) -----------------------------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=t4kash-attachments

# --- Notificaciones push (Firebase) --------------------------------------
# JSON de la cuenta de servicio de Firebase Admin en una sola linea
# (Project settings > Service accounts > Generate new private key).
# Vacio desactiva el push sin romper el arranque.
FIREBASE_CREDENTIALS_JSON=

# --- Verificacion de identidad (Didit) -----------------------------------
APP_DIDIT_ENABLED=false
DIDIT_API_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Minimo 32 caracteres: protege el numero de documento con HMAC.
DIDIT_DOCUMENT_HASH_SECRET=
DIDIT_WEBHOOK_TOLERANCE_SECONDS=300

# --- Pagos ---------------------------------------------------------------
# Take rate: el cliente paga este porcentaje encima del precio acordado y al
# estudiante se le retiene el suyo. Los pagos en efectivo no llevan comision.
APP_PAYMENTS_CLIENT_FEE_PERCENT=10.00
APP_PAYMENTS_STUDENT_FEE_PERCENT=5.00
# Aviso en los logs si hay fondos retenidos por mas de estos dias.
APP_PAYMENTS_HELD_FUNDS_ALERT_DAYS=14
APP_PAGADITO_ENABLED=false
APP_PAGADITO_ENVIRONMENT=SANDBOX
APP_PAGADITO_ENDPOINT=https://sandbox.pagadito.com/comercios/wspg/charges.php
PAGADITO_UID=
PAGADITO_WSK=
PAGADITO_PROCESSOR_FEE_PERCENT=0
PAGADITO_PROCESSOR_FIXED_FEE=0
PAGADITO_PROCESSOR_TAX_PERCENT=0

# --- Tareas programadas --------------------------------------------------
# Cierre de tareas vencidas y aviso de fondos retenidos.
APP_SCHEDULING_ENABLED=true
